# =============================================================================
# .bash_profile - macOS Bash 5.x Configuration
# =============================================================================
# General-purpose macOS Bash profile with Homebrew and optional tool integrations.
# Keep machine-specific overrides in local-only config where possible.
#
# Sections:
#   1. PATH Management
#   2. Environment Variables
#   3. Bash Options & History (Ultra-Clean Mode)
#   4. Tool Initialization
#   5. Shell Completions
#   6. Prompt & Navigation (Starship, zoxide)
#   7. Aliases & Functions
#   8. Utilities & Diagnostics
# =============================================================================

# =============================================================================
# 1. PATH MANAGEMENT
# =============================================================================

# Detect the common Homebrew prefix without invoking brew on every shell startup.
if [[ -x /opt/homebrew/bin/brew ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
elif [[ -x /usr/local/bin/brew ]]; then
  export HOMEBREW_PREFIX="/usr/local"
else
  export HOMEBREW_PREFIX="/opt/homebrew"
fi

# Optimized PATH: User bins -> Homebrew -> Keg-only tools -> System
# Priority order:
#   1. ~/.local/bin, ~/bin        - User-installed tools (highest priority)
#   2. /opt/homebrew/bin,sbin     - Homebrew (override system tools)
#   3. /opt/homebrew/opt/*/bin    - Keg-only formulas (curl, php, etc.)
#   4. $PATH                      - System paths (macOS defaults, lowest priority)
#
# Note: NVM, mise, and other tools will dynamically prepend their paths when loaded.
#       macOS cryptex paths (/var/run/com.apple.security.cryptexd/...) are placeholders
#       for Apple's Rapid Security Response system. They're usually empty but required.

export PATH="$HOME/.local/bin:$HOME/bin:$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$HOMEBREW_PREFIX/opt/curl/bin:$PATH"

# Utility function: Remove duplicate PATH entries while preserving order
path_dedupe() {
  if [ -n "$PATH" ]; then
    local new_path=""
    local path_array
    IFS=: read -ra path_array <<< "$PATH"
    for dir in "${path_array[@]}"; do
      if [[ ":$new_path:" != *":$dir:"* ]]; then
        new_path="${new_path:+$new_path:}$dir"
      fi
    done
    PATH="$new_path"
    export PATH
  fi
}


# --- PATH Diagnostic Functions ---

# Show PATH in readable format with line numbers
path_show() {
  echo "=== Current PATH ==="
  echo "$PATH" | tr ':' '\n' | nl -w2 -s'. '
  echo ""
  echo "Total entries: $(echo "$PATH" | tr ':' '\n' | wc -l)"
  echo "Unique entries: $(echo "$PATH" | tr ':' '\n' | sort -u | wc -l)"
}

# Check for PATH issues and provide recommendations
path_doctor() {
  echo "=== PATH Health Check ==="
  echo ""
  
  # Check for duplicates
  local duplicates=$(echo "$PATH" | tr ':' '\n' | sort | uniq -d)
  if [[ -n "$duplicates" ]]; then
    echo "⚠️  Duplicate paths found:"
    echo "$duplicates" | sed 's/^/    /'
    echo ""
  else
    echo "✓ No duplicate paths"
  fi
  
  # Check Homebrew priority
  local homebrew_pos=$(echo "$PATH" | tr ':' '\n' | grep -n "^$HOMEBREW_PREFIX/bin$" | cut -d: -f1 | head -1)
  local usr_bin_pos=$(echo "$PATH" | tr ':' '\n' | grep -n "^/usr/bin$" | cut -d: -f1 | head -1)
  
  if [[ -n "$homebrew_pos" ]] && [[ -n "$usr_bin_pos" ]]; then
    if ((homebrew_pos < usr_bin_pos)); then
      echo "✓ Homebrew has priority over system tools"
    else
      echo "⚠️  System /usr/bin comes before Homebrew"
      echo "    Homebrew position: $homebrew_pos"
      echo "    /usr/bin position: $usr_bin_pos"
    fi
  fi
  echo ""
  
  # Check for non-existent directories
  echo "Checking for non-existent directories in PATH..."
  local missing_count=0
  local cryptex_count=0
  
  while IFS= read -r dir; do
    if [[ ! -d "$dir" ]]; then
      # Check if it's a cryptex path (expected to be missing - they're placeholders)
      if [[ "$dir" == *"com.apple.security.cryptexd"* ]]; then
        ((cryptex_count++))
      else
        echo "  ⚠️  Missing: $dir"
        ((missing_count++))
      fi
    fi
  done < <(echo "$PATH" | tr ':' '\n')
  
  if ((missing_count == 0)); then
    echo "✓ All PATH directories exist"
  else
    echo "  Found $missing_count missing directories"
  fi
  
  # Informational note about cryptex paths
  if ((cryptex_count > 0)); then
    echo "ℹ️  Note: $cryptex_count cryptex paths are placeholders (normal for macOS security updates)"
  fi
  echo ""
  
  # Check tool versions
  echo "=== Tool Versions ==="
  for tool in git python3 node npm jq awk curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      local tool_path=$(which "$tool")
      if [[ "$tool_path" == "$HOMEBREW_PREFIX"* ]]; then
        echo "  ✓ $tool: Homebrew ($tool_path)"
      elif [[ "$tool_path" == "$HOME"* ]]; then
        echo "  ℹ️  $tool: User install ($tool_path)"
      else
        echo "  ⚠️  $tool: System ($tool_path)"
      fi
    fi
  done
  echo ""
  
  echo "=== Summary ==="
  echo "Run 'brew doctor' for Homebrew-specific checks"
  echo "Run 'path_show' to see full PATH"
}


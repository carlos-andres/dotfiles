# --- Git Functions (with directory checking) ---
gsu() {
  if command -v bat >/dev/null 2>&1; then
    (git -c color.status=always status -uall -- ":!node_modules" ":!vendor" ":!storage" ":!logs" && \
     git ls-files --others -- ":!node_modules" ":!vendor" ":!storage" ":!logs") | bat --paging=always --style=plain
  else
    git -c color.status=always status -uall -- ":!node_modules" ":!vendor" ":!storage" ":!logs"
    git ls-files --others -- ":!node_modules" ":!vendor" ":!storage" ":!logs"
  fi
}


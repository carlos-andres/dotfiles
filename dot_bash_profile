# =============================================================================
# 6. PROMPT & NAVIGATION
# =============================================================================

# Strategy: Initialize tools first, then build a custom PROMPT_COMMAND that
# ensures direnv runs BEFORE Starship evaluates the prompt on every command.

# Initialize direnv (but we'll override its PROMPT_COMMAND)
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

# Initialize Starship prompt (but we'll override its PROMPT_COMMAND too)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# --- CRITICAL FIX: Ensure direnv runs BEFORE Starship ---
# Problem: By default, PROMPT_COMMAND hooks run left-to-right, causing Starship
# to evaluate the prompt with stale environment variables before direnv updates them.
#
# Solution: Build a custom PROMPT_COMMAND that explicitly orders execution:
#   1. History sync (write new commands, read from other shells)
#   2. direnv hook (update environment variables based on .envrc)
#   3. Starship precmd (render prompt with fresh environment)
#
# NOTE: We don't set PROMPT_COMMAND here because zoxide will be initialized later
# and will prepend its own hook. Instead, we'll set it at the very end of the file.


if [[ -r "${HOME}/.iterm2_shell_integration.bash" ]]; then
  # shellcheck disable=SC1090
  . "${HOME}/.iterm2_shell_integration.bash"
fi

# Load machine-specific overrides outside the tracked profile when needed.
if [[ -r "${HOME}/.bash_profile.local" ]]; then
  # shellcheck disable=SC1090
  . "${HOME}/.bash_profile.local"
fi

# Final deduplication to clean up any duplicates from tool initialization.
path_dedupe


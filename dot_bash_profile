# =============================================================================
# 3. BASH OPTIONS & HISTORY (Ultra-Clean Mode)
# =============================================================================

# --- Bash Shell Options ---
shopt -s histappend       # Append to history file, don't overwrite
shopt -s cmdhist          # Save multi-line commands as one line
shopt -s checkwinsize     # Update LINES and COLUMNS after each command
shopt -s cdspell          # Auto-correct minor typos in cd commands
shopt -s dirspell 2>/dev/null || true  # Auto-correct directory name typos
shopt -s nocaseglob       # Case-insensitive filename completion
# NOTE: dotglob is NOT enabled globally to prevent unexpected behavior
# (e.g., 'rm *' would include hidden files like .git, .env)
# Use 'shopt -s dotglob' temporarily in functions that need it
shopt -s extglob          # Extended pattern matching

# Disable lithist - store multi-line commands as single line
shopt -u lithist

# Enable globstar if supported (bash 4+)
if ((BASH_VERSINFO[0] >= 4)); then
  shopt -s globstar       # Enable ** recursive glob patterns
fi

# --- History Configuration: Ultra-Clean Mode ---
# Philosophy: Only ONE copy of each command, aggressive filtering

export HISTFILE="$HOME/.bash_history"
export HISTSIZE=5000                        # Commands in memory
export HISTFILESIZE=10000                   # Commands in file
export HISTCONTROL=ignoreboth:erasedups     # Ignore duplicates, space-prefixed, and erase all previous duplicates
export HISTTIMEFORMAT='%F %T '              # Timestamp format

# Aggressive filtering: Common noise commands
# Strategy: Block duplicates (&) and simple/frequent commands, but keep meaningful work
# Ignored: navigation (cd, z, pwd), listing (ls variants), history control, simple git
export HISTIGNORE='&:ls:ls *:ll:ll *:la:la *:l:l *:l1:l1 *:lf:lf *:pwd:exit:clear:history:history *:cd:cd *:cd ..:cd ../..:z:z *:bg:fg:jobs:gs:git status:gsp:gd:ga:gb:gl:gp:[ \t]*'

# --- Real-time History Management ---
# Cross-shell sync: write new commands, read from other shells
# NOTE: PROMPT_COMMAND is modified below after direnv/Starship initialization
__bash_history_sync() {
  history -a
  history -n
}

# --- History Utility Functions ---

# histclean: Deduplicate while preserving Bash timestamp records
histclean() {
  local hf="${HISTFILE:-$HOME/.bash_history}"
  [[ -f "$hf" ]] || { echo "No history file at $hf"; return 1; }
  
  echo "Cleaning history: $hf"
  
  # Backup
  local backup="${hf}.bak.$(date +%Y%m%d-%H%M%S)"
  cp -p "$hf" "$backup"
  echo "  → Backup created: $backup"
  
  # Count before
  local before=$(grep -cv "^#" "$hf" 2>/dev/null || echo 0)
  
  # Deduplicate while preserving the timestamp line paired with each command.
  # This keeps the last occurrence of each command in chronological order.
  awk '
    function emit(idx) {
      if (ts[idx] != "") {
        print ts[idx]
      }
      print cmd[idx]
    }
    /^#[0-9]+$/ {
      pending_ts=$0
      next
    }
    {
      n++
      cmd[n]=$0
      ts[n]=pending_ts
      pending_ts=""
      last[$0]=n
    }
    END {
      for (i = 1; i <= n; i++) {
        if (last[cmd[i]] == i) {
          emit(i)
        }
      }
    }
  ' "$hf" > "${hf}.tmp" && mv "${hf}.tmp" "$hf"
  
  # Count after
  local after=$(grep -cv "^#" "$hf" 2>/dev/null || echo 0)
  local removed=$((before - after))
  
  # Reload
  history -c
  history -r "$hf"
  
  echo "  → Cleaned: $before → $after commands ($removed duplicates removed)"
  echo "  ✓ History reloaded into current shell"
}

# histnuke: Clear all history (with confirmation)
histnuke() {
  read -p "⚠️  Clear ALL history? This cannot be undone. [y/N] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    history -c
    : >| "$HISTFILE"
    echo "✓ History cleared (both memory and file)"
  else
    echo "Cancelled."
  fi
}

# histstats: Show history statistics
histstats() {
  local hf="${HISTFILE:-$HOME/.bash_history}"
  [[ -f "$hf" ]] || { echo "No history file at $hf"; return 1; }
  
  local total=$(wc -l < "$hf")
  local timestamps=$(grep -c "^#" "$hf" 2>/dev/null || echo 0)
  local commands=$((total - timestamps))
  local unique=$(grep -v "^#" "$hf" | sort -u | wc -l)
  local duplicates=$((commands - unique))
  local duplicate_pct=0
  [[ $commands -gt 0 ]] && duplicate_pct=$(( (duplicates * 100) / commands ))
  
  echo "=== History Statistics ==="
  echo "File: $hf"
  echo "Total lines: $total"
  echo "Commands: $commands"
  echo "Unique: $unique"
  echo "Duplicates: $duplicates ($duplicate_pct%)"
  echo ""
  echo "Top 10 most repeated commands:"
  grep -v "^#" "$hf" | sort | uniq -c | sort -rn | head -10
}


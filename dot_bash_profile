prev() {
  command -v pet >/dev/null 2>&1 || { echo "pet is required for prev" >&2; return 1; }

  local prev_cmd
  prev_cmd=$(history | tail -n 2 | head -n 1 | sed 's/^[[:space:]]*[0-9][0-9]*[[:space:]]*//')
  [[ -n "$prev_cmd" ]] || { echo "No previous command found" >&2; return 1; }

  pet new "$prev_cmd"
}


# --- SSH Fuzzy Finder ---
sshf() {
  command -v fzf >/dev/null 2>&1 || { echo "fzf is required for sshf" >&2; return 1; }
  [[ -r "$HOME/.ssh/config" ]] || { echo "No readable SSH config at $HOME/.ssh/config" >&2; return 1; }

  local host
  host=$(awk '/^Host[[:space:]]/ {print $2}' ~/.ssh/config 2>/dev/null | \
    grep -v '\*' | \
    sort -u | \
    fzf --height 40% --reverse --border --prompt="SSH to: ")
  
  [[ -n "$host" ]] && ssh "$host"
}
alias sshq='sshf'


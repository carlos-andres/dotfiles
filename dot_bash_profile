# =============================================================================
# FINAL PROMPT_COMMAND SETUP (Must be after ALL tool initializations)
# =============================================================================
# Now that all tools have been initialized, rebuild PROMPT_COMMAND with proper ordering
# This ensures direnv runs BEFORE Starship evaluates the prompt

if declare -f _direnv_hook >/dev/null 2>&1 && command -v starship >/dev/null 2>&1; then
  # Both direnv and starship are available - use ordered execution
  # Format: zoxide (if present) ; history ; direnv ; starship
  if declare -f __zoxide_hook >/dev/null 2>&1; then
    PROMPT_COMMAND='__zoxide_hook; __bash_history_sync; _direnv_hook; starship_precmd'
  else
    PROMPT_COMMAND='__bash_history_sync; _direnv_hook; starship_precmd'
  fi
elif declare -f _direnv_hook >/dev/null 2>&1; then
  # Only direnv available
  if declare -f __zoxide_hook >/dev/null 2>&1; then
    PROMPT_COMMAND='__zoxide_hook; __bash_history_sync; _direnv_hook'
  else
    PROMPT_COMMAND='__bash_history_sync; _direnv_hook'
  fi
elif command -v starship >/dev/null 2>&1; then
  # Only starship available
  if declare -f __zoxide_hook >/dev/null 2>&1; then
    PROMPT_COMMAND='__zoxide_hook; __bash_history_sync; starship_precmd'
  else
    PROMPT_COMMAND='__bash_history_sync; starship_precmd'
  fi
else
  # Neither direnv nor starship - just history sync (and maybe zoxide)
  if declare -f __zoxide_hook >/dev/null 2>&1; then
    PROMPT_COMMAND='__zoxide_hook; __bash_history_sync'
  else
    PROMPT_COMMAND='__bash_history_sync'
  fi
fi

